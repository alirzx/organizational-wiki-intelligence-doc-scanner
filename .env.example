# Wiki Hami Extraction V1
WIKI_HAMI_ENVIRONMENT=local
WIKI_HAMI_LOG_LEVEL=INFO

PADDLE_PDX_MODEL_SOURCE=HUGGINGFACE

# Scanner model dependency/container runtime.
# GPU image is required if any in-process Paddle/Torch module needs a GPU.
WIKI_HAMI_MODEL_RUNTIME=cpu
WIKI_HAMI_CONTAINER_RUNTIME=runc
WIKI_HAMI_NVIDIA_VISIBLE_DEVICES=none

# API / workload limits
WIKI_HAMI_MAX_UPLOAD_BYTES=26214400
WIKI_HAMI_MAX_IMAGE_PIXELS=50000000
WIKI_HAMI_MAX_PAGES_PER_DOCUMENT=200
WIKI_HAMI_PREPROCESS_MAX_LONG_EDGE=2500
WIKI_HAMI_PAGE_CONCURRENCY=1
WIKI_HAMI_MODULE_TIMEOUT_SECONDS=360

# MinIO / S3 input + artifact output
WIKI_HAMI_MINIO_ENABLED=false
WIKI_HAMI_MINIO_ENDPOINT=localhost:9000
WIKI_HAMI_MINIO_ACCESS_KEY=change-me
WIKI_HAMI_MINIO_SECRET_KEY=change-me
WIKI_HAMI_MINIO_SECURE=false
WIKI_HAMI_MINIO_BUCKET=media
WIKI_HAMI_MINIO_PUBLIC_BASE_URL=http://localhost:9000
WIKI_HAMI_MINIO_BROWSER_ENABLED=true
WIKI_HAMI_MINIO_LIST_LIMIT=500

# Async production jobs
WIKI_HAMI_CELERY_BROKER_URL=redis://redis:6379/0
WIKI_HAMI_CELERY_RESULT_BACKEND=redis://redis:6379/1
WIKI_HAMI_CELERY_QUEUE=wiki_hami_extraction
WIKI_HAMI_JOB_STORE_BACKEND=redis
WIKI_HAMI_JOB_STORE_REDIS_URL=redis://redis:6379/2
WIKI_HAMI_JOB_STORE_TTL_SECONDS=604800

# Backend -> AI authentication
WIKI_HAMI_BACKEND_API_KEY=

# AI -> Backend terminal callback
WIKI_HAMI_CALLBACK_URL=
WIKI_HAMI_CALLBACK_TOKEN=
WIKI_HAMI_CALLBACK_TIMEOUT_SECONDS=15
WIKI_HAMI_CALLBACK_MAX_ATTEMPTS=3

# Text extraction selector:
# vlm -> isolated project Ollama + DeepSeek-OCR
# ocr -> classic in-process Paddle or Bina
WIKI_HAMI_TEXT_EXTRACTION_MODE=vlm

# Classic OCR path
WIKI_HAMI_OCR_BACKEND=bina_rizeh
WIKI_HAMI_OCR_MODEL_ID=PaddlePaddle/arabic_PP-OCRv5_mobile_rec
WIKI_HAMI_OCR_TEXT_DETECTION_MODEL_NAME=PP-OCRv5_server_det
WIKI_HAMI_OCR_DEVICE=cpu
WIKI_HAMI_OCR_ENABLE_MKLDNN=false
WIKI_HAMI_OCR_SCORE_THRESHOLD=0.45
WIKI_HAMI_OCR_USE_TEXTLINE_ORIENTATION=true

# Bina Rizeh
WIKI_HAMI_OCR_BINA_MODEL_ID=Reza2kn/Bina-0.2-RizehPizeh
WIKI_HAMI_OCR_BINA_REVISION=993527413ff74ef6d446df91c715a4e0825abe5b
WIKI_HAMI_OCR_BINA_SCORE_THRESHOLD=0.0
WIKI_HAMI_OCR_BINA_BATCH_SIZE=1
WIKI_HAMI_OCR_DETECTION_MODEL_ID=PaddlePaddle/PP-OCRv6_medium_det
WIKI_HAMI_OCR_DETECTION_MODEL_REVISION=8e0f56fb2ef86b461d99cfc7ac5c137738985f61
WIKI_HAMI_OCR_PARAGRAPH_MAX_GAP_RATIO=1.8
WIKI_HAMI_OCR_PARAGRAPH_MIN_X_OVERLAP=0.15

# VLM path
WIKI_HAMI_VLM_BACKEND=ollama
WIKI_HAMI_VLM_MODEL_ID=deepseek-ocr:latest
WIKI_HAMI_VLM_BASE_URL=http://ollama:11434
WIKI_HAMI_VLM_TIMEOUT_SECONDS=360
WIKI_HAMI_VLM_PROMPT="\nExtract the text in the image."
WIKI_HAMI_VLM_MAX_TOKENS=3072
WIKI_HAMI_VLM_CONTEXT_SIZE=4096
WIKI_HAMI_VLM_NUM_THREADS=2
WIKI_HAMI_VLM_REPEAT_PENALTY=1.1
WIKI_HAMI_VLM_QUALITY_RETRIES=1
WIKI_HAMI_VLM_CROP_MARGINS=true
WIKI_HAMI_VLM_REGION_FALLBACK=true
WIKI_HAMI_VLM_CLASSIC_FALLBACK=true
WIKI_HAMI_VLM_DIAGNOSTICS_DIR=data/outputs/ocr-diagnostics
WIKI_HAMI_VLM_DIAGNOSTICS_MAX_FILES=64
WIKI_HAMI_VLM_KEEP_ALIVE=30s

# Isolated Ollama service. The selected model is stored in a project-owned
# persistent volume and pulled only if it is absent. For CPU-only VLM use
# runc + none.
WIKI_HAMI_OLLAMA_IMAGE=ollama/ollama:0.40.0
WIKI_HAMI_OLLAMA_CONTAINER_RUNTIME=runc
WIKI_HAMI_OLLAMA_NVIDIA_VISIBLE_DEVICES=none
WIKI_HAMI_OLLAMA_KEEP_ALIVE=30s
WIKI_HAMI_OLLAMA_MAX_LOADED_MODELS=1
WIKI_HAMI_OLLAMA_NUM_PARALLEL=1
WIKI_HAMI_OLLAMA_MAX_QUEUE=2
WIKI_HAMI_OLLAMA_MODEL_STORE_MAX_MB=12288
WIKI_HAMI_OLLAMA_MAX_TRANSFER_STREAMS=1
WIKI_HAMI_OLLAMA_GOMAXPROCS=2

# CPU thread caps for in-process Paddle/Torch/numpy stacks.
WIKI_HAMI_CPU_OMP_NUM_THREADS=1
WIKI_HAMI_CPU_BLAS_NUM_THREADS=1
WIKI_HAMI_CPU_MKL_NUM_THREADS=1
WIKI_HAMI_CPU_NUMEXPR_NUM_THREADS=1

# Resource envelope for a shared ~30 GB / 7-core stage host.
# Runtime scanner CPU maxima total ~3.75 cores, preserving >3 cores for
# Backend, Frontend, Redis, MinIO and the other Wiki Hami services.
WIKI_HAMI_OLLAMA_MEMORY_LIMIT=10g
WIKI_HAMI_OLLAMA_MEMORY_RESERVATION=6g
WIKI_HAMI_OLLAMA_MEMORY_SWAP_LIMIT=10g
WIKI_HAMI_OLLAMA_CPUS=2.0
WIKI_HAMI_OLLAMA_PIDS_LIMIT=256
WIKI_HAMI_OLLAMA_INIT_MEMORY_LIMIT=512m
WIKI_HAMI_OLLAMA_INIT_MEMORY_SWAP_LIMIT=512m
WIKI_HAMI_OLLAMA_INIT_CPUS=0.5
WIKI_HAMI_OLLAMA_INIT_PIDS_LIMIT=96

WIKI_HAMI_WORKER_MEMORY_LIMIT=7g
WIKI_HAMI_WORKER_MEMORY_RESERVATION=3g
WIKI_HAMI_WORKER_MEMORY_SWAP_LIMIT=7g
WIKI_HAMI_WORKER_CPUS=1.0
WIKI_HAMI_WORKER_PIDS_LIMIT=256

WIKI_HAMI_API_MEMORY_LIMIT=1g
WIKI_HAMI_API_MEMORY_RESERVATION=256m
WIKI_HAMI_API_MEMORY_SWAP_LIMIT=1g
WIKI_HAMI_API_CPUS=0.5
WIKI_HAMI_API_PIDS_LIMIT=128

WIKI_HAMI_UI_MEMORY_LIMIT=512m
WIKI_HAMI_UI_MEMORY_RESERVATION=128m
WIKI_HAMI_UI_MEMORY_SWAP_LIMIT=512m
WIKI_HAMI_UI_CPUS=0.25
WIKI_HAMI_UI_PIDS_LIMIT=64

# Bound Docker json-file logs so inference cannot fill the host disk.
WIKI_HAMI_LOG_MAX_SIZE=20m
WIKI_HAMI_LOG_MAX_FILES=3

# Figure / Table
WIKI_HAMI_FIGURE_TABLE_BACKEND=mock
WIKI_HAMI_FIGURE_TABLE_MODEL_ID=PaddlePaddle/PP-DocLayoutV3
WIKI_HAMI_FIGURE_TABLE_DEVICE=cpu
WIKI_HAMI_FIGURE_TABLE_SCORE_THRESHOLD=0.45
WIKI_HAMI_FIGURE_LABELS=figure,image,chart
WIKI_HAMI_TABLE_LABELS=table

# Stamp / Signature
WIKI_HAMI_STAMP_SIGNATURE_BACKEND=mock
WIKI_HAMI_STAMP_SIGNATURE_MODEL_ID=bluecopa/rf-detr-stamp-signature-detector
WIKI_HAMI_STAMP_SIGNATURE_CHECKPOINT_FILENAME=checkpoint_best_ema.pth
WIKI_HAMI_STAMP_SIGNATURE_MODEL_REVISION=c59fd4f451b254501700a56c7769f1a3d788c753
WIKI_HAMI_STAMP_SIGNATURE_DEVICE=cpu
WIKI_HAMI_STAMP_SIGNATURE_SCORE_THRESHOLD=0.50

# Streamlit
WIKI_HAMI_API_BASE=http://localhost:8000/api/v1
