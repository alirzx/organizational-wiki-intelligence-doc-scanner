# Wiki Hami Extraction V1
WIKI_HAMI_ENVIRONMENT=local
WIKI_HAMI_LOG_LEVEL=INFO

PADDLE_PDX_MODEL_SOURCE=HUGGINGFACE

# Docker/model runtime is GPU-only. CUDA wheel channels are pinned in Dockerfile
# to the verified deployment baseline; no build-time package-index variables are required.

# API / workload limits
WIKI_HAMI_MAX_UPLOAD_BYTES=26214400
WIKI_HAMI_MAX_IMAGE_PIXELS=50000000
WIKI_HAMI_MAX_PAGES_PER_DOCUMENT=200
WIKI_HAMI_PREPROCESS_MAX_LONG_EDGE=2500
WIKI_HAMI_PAGE_CONCURRENCY=4
WIKI_HAMI_MODULE_TIMEOUT_SECONDS=360

# MinIO / S3 input + artifact output
WIKI_HAMI_MINIO_ENABLED=false
WIKI_HAMI_MINIO_ENDPOINT=localhost:9000
WIKI_HAMI_MINIO_ACCESS_KEY=change-me
WIKI_HAMI_MINIO_SECRET_KEY=change-me
WIKI_HAMI_MINIO_SECURE=false
WIKI_HAMI_MINIO_BUCKET=media
WIKI_HAMI_MINIO_PUBLIC_BASE_URL=http://localhost:9000
WIKI_HAMI_MINIO_BROWSER_ENABLED=true
WIKI_HAMI_MINIO_LIST_LIMIT=500

# Async production jobs
# Production needs both the API process and a Celery worker.
WIKI_HAMI_CELERY_BROKER_URL=redis://redis:6379/0
WIKI_HAMI_CELERY_RESULT_BACKEND=redis://redis:6379/1
WIKI_HAMI_CELERY_QUEUE=wiki_hami_extraction
WIKI_HAMI_JOB_STORE_BACKEND=redis
WIKI_HAMI_JOB_STORE_REDIS_URL=redis://redis:6379/2
WIKI_HAMI_JOB_STORE_TTL_SECONDS=604800

# Backend -> AI authentication. Backend sends: X-API-Key: <value>
# Leave empty only for local/dev inspection.
WIKI_HAMI_BACKEND_API_KEY=

# AI -> Backend terminal callback. AI sends: Authorization: Bearer <token>
# The request payload does not carry callback_url, so the existing /extract/minio schema stays unchanged.
WIKI_HAMI_CALLBACK_URL=
WIKI_HAMI_CALLBACK_TOKEN=
WIKI_HAMI_CALLBACK_TIMEOUT_SECONDS=15
WIKI_HAMI_CALLBACK_MAX_ATTEMPTS=3

# Text extraction
# Default production path is the remote VLM. Set to "ocr" to use Paddle/Bina instead.
WIKI_HAMI_TEXT_EXTRACTION_MODE=vlm

# Classic OCR path (used only when WIKI_HAMI_TEXT_EXTRACTION_MODE=ocr).
# Supported values: mock, paddle, bina_rizeh. Mock is for development/tests.
WIKI_HAMI_OCR_BACKEND=bina_rizeh
# Paddle-only detector/recognizer settings, retained for WIKI_HAMI_OCR_BACKEND=paddle.
WIKI_HAMI_OCR_MODEL_ID=PaddlePaddle/arabic_PP-OCRv5_mobile_rec
WIKI_HAMI_OCR_TEXT_DETECTION_MODEL_NAME=PP-OCRv5_server_det
WIKI_HAMI_OCR_DEVICE=gpu:0
# oneDNN/MKLDNN is disabled; production inference is GPU-backed.
WIKI_HAMI_OCR_ENABLE_MKLDNN=false
WIKI_HAMI_OCR_SCORE_THRESHOLD=0.45
WIKI_HAMI_OCR_USE_TEXTLINE_ORIENTATION=true
# Bina Rizeh full-page backend: independent PP-OCRv6 detector, rectified line
# crops, and the official Persian line recognizer. Revisions are immutable.
WIKI_HAMI_OCR_BINA_MODEL_ID=Reza2kn/Bina-0.2-RizehPizeh
WIKI_HAMI_OCR_BINA_REVISION=993527413ff74ef6d446df91c715a4e0825abe5b
WIKI_HAMI_OCR_BINA_SCORE_THRESHOLD=0.0
WIKI_HAMI_OCR_BINA_BATCH_SIZE=1
WIKI_HAMI_OCR_DETECTION_MODEL_ID=PaddlePaddle/PP-OCRv6_medium_det
WIKI_HAMI_OCR_DETECTION_MODEL_REVISION=8e0f56fb2ef86b461d99cfc7ac5c137738985f61
WIKI_HAMI_OCR_PARAGRAPH_MAX_GAP_RATIO=1.8
WIKI_HAMI_OCR_PARAGRAPH_MIN_X_OVERLAP=0.15

# VLM path (used only when WIKI_HAMI_TEXT_EXTRACTION_MODE=vlm).
# Ollama exposes its REST API on port 11434. Point this at the reachable server/VPN address.
WIKI_HAMI_VLM_BACKEND=ollama
WIKI_HAMI_VLM_MODEL_ID=deepseek-ocr:latest
WIKI_HAMI_VLM_BASE_URL=http://localhost:11434
WIKI_HAMI_VLM_TIMEOUT_SECONDS=360
WIKI_HAMI_VLM_PROMPT=<|grounding|>OCR this image.

# Figure / Table
WIKI_HAMI_FIGURE_TABLE_BACKEND=mock
WIKI_HAMI_FIGURE_TABLE_MODEL_ID=PaddlePaddle/PP-DocLayoutV3
WIKI_HAMI_FIGURE_TABLE_DEVICE=gpu:0
WIKI_HAMI_FIGURE_TABLE_SCORE_THRESHOLD=0.45
WIKI_HAMI_FIGURE_LABELS=figure,image,chart
WIKI_HAMI_TABLE_LABELS=table

# Stamp / Signature
WIKI_HAMI_STAMP_SIGNATURE_BACKEND=mock
WIKI_HAMI_STAMP_SIGNATURE_MODEL_ID=bluecopa/rf-detr-stamp-signature-detector
WIKI_HAMI_STAMP_SIGNATURE_CHECKPOINT_FILENAME=checkpoint_best_ema.pth
WIKI_HAMI_STAMP_SIGNATURE_MODEL_REVISION=c59fd4f451b254501700a56c7769f1a3d788c753
WIKI_HAMI_STAMP_SIGNATURE_DEVICE=cuda:0
WIKI_HAMI_STAMP_SIGNATURE_SCORE_THRESHOLD=0.50

# Streamlit
WIKI_HAMI_API_BASE=http://localhost:8000/api/v1
