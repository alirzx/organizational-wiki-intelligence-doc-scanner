# Wiki Hami Extraction V1
WIKI_HAMI_ENVIRONMENT=local
WIKI_HAMI_LOG_LEVEL=INFO

# Optional local framework cache overrides. Defaults are ~/.cache/huggingface,
# ~/.cache/paddle, and ~/.paddlex. Container paths are set in Compose/Dockerfile.
# HF_HOME=/absolute/writable/path/huggingface
# PADDLE_HOME=/absolute/writable/path/paddle
# PADDLE_PDX_CACHE_HOME=/absolute/writable/path/paddlex
PADDLE_PDX_MODEL_SOURCE=HUGGINGFACE

# API / workload limits
WIKI_HAMI_MAX_UPLOAD_BYTES=26214400
WIKI_HAMI_MAX_IMAGE_PIXELS=50000000
WIKI_HAMI_MAX_PAGES_PER_DOCUMENT=100
WIKI_HAMI_PREPROCESS_MAX_LONG_EDGE=2500
WIKI_HAMI_PAGE_CONCURRENCY=4
WIKI_HAMI_MODULE_TIMEOUT_SECONDS=180

# MinIO / S3 input + artifact output
# Local example (host-exposed S3):
#   WIKI_HAMI_MINIO_ENDPOINT=192.168.4.209:9002
#   WIKI_HAMI_MINIO_PUBLIC_BASE_URL=http://192.168.4.209:9002
# Server/product example when Backend sends http://minio:9000/media/... URLs:
#   WIKI_HAMI_MINIO_ENDPOINT=minio:9000
#   WIKI_HAMI_MINIO_PUBLIC_BASE_URL=http://minio:9000
WIKI_HAMI_MINIO_ENABLED=false
WIKI_HAMI_MINIO_ENDPOINT=localhost:9000
WIKI_HAMI_MINIO_ACCESS_KEY=change-me
WIKI_HAMI_MINIO_SECRET_KEY=change-me
WIKI_HAMI_MINIO_SECURE=false
WIKI_HAMI_MINIO_BUCKET=media
WIKI_HAMI_MINIO_PUBLIC_BASE_URL=http://localhost:9000
# Enables the local Streamlit object browser/proxy endpoints. Disable in a
# production deployment that does not need the internal inspection UI.
WIKI_HAMI_MINIO_BROWSER_ENABLED=true
WIKI_HAMI_MINIO_LIST_LIMIT=500

# OCR
# mock | paddle
WIKI_HAMI_OCR_BACKEND=mock
WIKI_HAMI_OCR_MODEL_ID=PaddlePaddle/arabic_PP-OCRv5_mobile_rec
WIKI_HAMI_OCR_TEXT_DETECTION_MODEL_NAME=PP-OCRv5_server_det
WIKI_HAMI_OCR_DEVICE=cpu
WIKI_HAMI_OCR_SCORE_THRESHOLD=0.45
WIKI_HAMI_OCR_USE_TEXTLINE_ORIENTATION=true
WIKI_HAMI_OCR_PARAGRAPH_MAX_GAP_RATIO=1.8
WIKI_HAMI_OCR_PARAGRAPH_MIN_X_OVERLAP=0.15

# Figure / Table
# mock | pp_doclayout
WIKI_HAMI_FIGURE_TABLE_BACKEND=mock
WIKI_HAMI_FIGURE_TABLE_MODEL_ID=PaddlePaddle/PP-DocLayoutV3
WIKI_HAMI_FIGURE_TABLE_DEVICE=cpu
WIKI_HAMI_FIGURE_TABLE_SCORE_THRESHOLD=0.45
WIKI_HAMI_FIGURE_LABELS=figure,image,chart
WIKI_HAMI_TABLE_LABELS=table

# Stamp / Signature
# mock | rfdetr
WIKI_HAMI_STAMP_SIGNATURE_BACKEND=mock
WIKI_HAMI_STAMP_SIGNATURE_MODEL_ID=bluecopa/rf-detr-stamp-signature-detector
WIKI_HAMI_STAMP_SIGNATURE_CHECKPOINT_FILENAME=checkpoint_best_ema.pth
WIKI_HAMI_STAMP_SIGNATURE_MODEL_REVISION=c59fd4f451b254501700a56c7769f1a3d788c753
WIKI_HAMI_STAMP_SIGNATURE_DEVICE=cpu
WIKI_HAMI_STAMP_SIGNATURE_SCORE_THRESHOLD=0.50
# Optional override for only the RF-DETR hf_hub_download call. When unset, HF_HOME is used.
# WIKI_HAMI_STAMP_SIGNATURE_CACHE_DIR=/app/.cache/huggingface

# Streamlit
WIKI_HAMI_API_BASE=http://localhost:8000/api/v1
